{
  "name": "Barber",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this barber profile"
    },
    "display_name": {
      "type": "string",
      "description": "Barber's display name"
    },
    "bio": {
      "type": "string",
      "description": "Short bio about the barber"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio images"
    },
    "city": {
      "type": "string",
      "description": "City where barber operates"
    },
    "neighborhood": {
      "type": "string",
      "description": "Specific neighborhood or area"
    },
    "license_verified": {
      "type": "boolean",
      "default": false
    },
    "license_image": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "is_available_now": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "action_required",
        "active",
        "suspended"
      ],
      "default": "pending",
      "description": "Barber account status. Only 'active' barbers are publicly visible."
    },
    "admin_note": {
      "type": "string",
      "description": "Admin-facing note shown to barber when action is required. Set when admin sends barber back to action_required."
    },
    "working_hours": {
      "type": "object"
    },
    "years_experience": {
      "type": "number"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account ID (acct_xxx) \u2014 set when barber connects Stripe"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once barber has completed Stripe onboarding flow"
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when Stripe confirms charges and payouts are enabled"
    },
    "stripe_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "onboarding_required",
        "onboarding_in_progress",
        "verification_needed",
        "active"
      ],
      "default": "not_connected",
      "description": "Current Stripe Connect status for this barber"
    }
  },
  "required": [
    "user_email",
    "display_name",
    "city"
  ]
}