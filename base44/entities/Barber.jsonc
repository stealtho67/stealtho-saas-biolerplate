{
  "name": "Barber",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this barber profile"
    },
    "display_name": {
      "type": "string",
      "description": "Barber's display name"
    },
    "bio": {
      "type": "string",
      "description": "Short bio about the barber"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio images"
    },
    "city": {
      "type": "string",
      "description": "City where barber operates"
    },
    "neighborhood": {
      "type": "string",
      "description": "Specific neighborhood or area"
    },
    "license_verified": {
      "type": "boolean",
      "default": false
    },
    "license_image": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "is_available_now": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "action_required",
        "active",
        "suspended"
      ],
      "default": "pending",
      "description": "Barber account status. Only 'active' barbers are publicly visible."
    },
    "admin_note": {
      "type": "string",
      "description": "Admin-facing note shown to barber when action is required."
    },
    "working_hours": {
      "type": "object"
    },
    "years_experience": {
      "type": "number"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account ID (acct_xxx)"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "onboarding_required",
        "onboarding_in_progress",
        "verification_needed",
        "active"
      ],
      "default": "not_connected"
    },
    "no_show_fee": {
      "type": "number",
      "default": 0,
      "description": "Dollar amount to charge on no-show (0 = disabled)"
    },
    "no_show_policy_hours": {
      "type": "number",
      "default": 24,
      "description": "Hours before appointment that cancellation is free"
    },
    "booking_delivery_method": {
      "type": "string",
      "enum": [
        "nextcut_only",
        "email",
        "webhook",
        "website"
      ],
      "default": "nextcut_only",
      "description": "How the barber wants booking/client info forwarded after a booking is made."
    },
    "booking_delivery_email": {
      "type": "string",
      "description": "Email address to forward booking notifications to (used when method=email)."
    },
    "booking_delivery_webhook_url": {
      "type": "string",
      "description": "Webhook/intake URL to POST booking data to (used when method=webhook)."
    },
    "booking_delivery_website_url": {
      "type": "string",
      "description": "External booking page or website URL \u2014 stored for reference (used when method=website)."
    },
    "barbershop_id": {
      "type": "string",
      "description": "ID of the Barbershop this barber belongs to (optional). Null means solo/independent barber."
    }
  },
  "required": [
    "user_email",
    "display_name",
    "city"
  ]
}