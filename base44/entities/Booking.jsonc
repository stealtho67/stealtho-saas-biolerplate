{
  "name": "Booking",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "barber_id": {
      "type": "string"
    },
    "barber_name": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Legacy price field \u2014 same as service_price"
    },
    "service_price": {
      "type": "number",
      "description": "Total service price charged to client"
    },
    "platform_fee": {
      "type": "number",
      "description": "Platform commission (15% of service_price)"
    },
    "barber_earnings": {
      "type": "number",
      "description": "Barber's net earnings after platform fee"
    },
    "date": {
      "type": "string",
      "description": "Date of booking (YYYY-MM-DD)"
    },
    "time": {
      "type": "string",
      "description": "Time of booking (HH:MM)"
    },
    "duration_minutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "confirmed"
    },
    "notes": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid",
      "description": "Whether the booking has been paid"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "in_person",
        "stripe",
        "other"
      ],
      "description": "How payment was collected"
    },
    "paid_at": {
      "type": "string",
      "description": "ISO timestamp of when payment was confirmed"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID \u2014 populated when Stripe is active"
    }
  },
  "required": [
    "client_email",
    "barber_id",
    "service_id",
    "date",
    "time",
    "status"
  ]
}